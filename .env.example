PORT=8787
HOST=0.0.0.0
RATE_LIMIT_PER_MINUTE=120

# Durable production persistence. Run: npm run migrate
DATABASE_URL=

# Required for POST/PATCH /api/assets administrative writes.
ADMIN_API_KEY=

# Ethereum mainnet RPC used for contract health checks and eth_call simulation.
ETH_RPC_URL=

# Enables live CoW Orderbook quotes.
ENABLE_COW_LIVE=false

# Trusted eligibility/attestation provider for production permissioned assets.
ELIGIBILITY_PROVIDER_URL=
ELIGIBILITY_PROVIDER_API_KEY=

# Optional approved OpenEden issuer/provider bridge for direct mint/redeem.
OPENEDEN_QUOTE_URL=
OPENEDEN_API_KEY=


# --- 33jane AI platform (Milestones 1-5) ---
JANE_PUBLIC_URL=https://33jane.vercel.app

# At least one live provider is required for /api/ai/chat.
# The router and price preview work without provider keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASON_MODEL=gpt-5-mini
OPENAI_INPUT_COST_PER_M=0.25
OPENAI_OUTPUT_COST_PER_M=2
OPENAI_ZERO_RETENTION=false

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=openai/gpt-oss-120b
GROQ_INPUT_COST_PER_M=0.15
GROQ_OUTPUT_COST_PER_M=0.60
GROQ_ZERO_RETENTION=false

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ECONOMY_MODEL=qwen/qwen3-30b-a3b
OPENROUTER_INPUT_COST_PER_M=0.10
OPENROUTER_OUTPUT_COST_PER_M=0.30
OPENROUTER_ZERO_RETENTION=false

# Optional OpenAI-compatible confidential/zero-retention endpoint.
JANE_PRIVATE_BASE_URL=
JANE_PRIVATE_API_KEY=
JANE_PRIVATE_MODEL=
JANE_PRIVATE_INPUT_COST_PER_M=0.40
JANE_PRIVATE_OUTPUT_COST_PER_M=1.20
