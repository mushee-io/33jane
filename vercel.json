{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" },

    { "source": "/health", "destination": "/api/index?path=health" },
    { "source": "/readiness", "destination": "/api/index?path=readiness" },
    { "source": "/assets", "destination": "/api/index?path=assets" },
    { "source": "/assets/:id", "destination": "/api/index?path=assets/:id" },
    { "source": "/integrations", "destination": "/api/index?path=integrations" },
    { "source": "/evidence", "destination": "/api/index?path=evidence" },
    { "source": "/monitor", "destination": "/api/index?path=monitor" },
    { "source": "/live/quote", "destination": "/api/index?path=live/quote" },
    { "source": "/eligibility", "destination": "/api/index?path=eligibility" },
    { "source": "/quote", "destination": "/api/index?path=route" },
    { "source": "/route", "destination": "/api/index?path=route" },
    { "source": "/simulate", "destination": "/api/index?path=execute/prepare" },
    { "source": "/cow/solve", "destination": "/api/index?path=cow/route" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
